# =============================================================================
# EXEMPLO DE VARIÁVEIS DE AMBIENTE (.env.example)
# =============================================================================
# 1. Para desenvolvimento local com Docker Compose ('docker compose up -d --build'):
#    Nenhuma variável abaixo é obrigatória! O profile 'docker' já possui todos
#    os valores padrão sincronizados com o 'realm-export.json' e com o Mailpit.
#
# 2. Para deploy em PRODUÇÃO:
#    Defina obrigatoriamente SPRING_PROFILES_ACTIVE=prod e preencha TODAS as
#    variáveis abaixo. No profile 'prod', a aplicação opera em modo Fail-Fast
#    e bloqueará o boot caso qualquer credencial esteja ausente ou utilize
#    valores de desenvolvimento.
# =============================================================================

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8082
UPLOAD_DIR=/app/storage

# Banco de Dados PostgreSQL
DB_URL=jdbc:postgresql://seu-host-postgres:5432/prae
DB_USER=prae_prod_user
DB_PASS=DEFINA_SENHA_FORTE_AQUI

# Keycloak (Autenticação e Autorização)
KEYCLOAK_URL=https://auth.ufape.edu.br
KEYCLOAK_ISSUER_URI=https://auth.ufape.edu.br/realms/sgu-ufape
KEYCLOAK_REALM=sgu-ufape
KEYCLOAK_CLIENT_ID=sgu-application
KEYCLOAK_CLIENT_SECRET=DEFINA_SECRET_DE_PRODUCAO_AQUI

# RabbitMQ (Mensageria)
RABBITMQ_HOST=seu-host-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=prae_rabbit_user
RABBITMQ_PASS=DEFINA_SENHA_FORTE_AQUI

# Redis (Cache de Notificações)
REDIS_HOST=seu-host-redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Servidor SMTP (Envio de E-mails de Notificação)
MAIL_HOST=smtp.ufape.edu.br
MAIL_PORT=587
MAIL_USERNAME=nao-responda@ufape.edu.br
MAIL_PASSWORD=DEFINA_SENHA_SMTP_AQUI
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# Frontend (CORS - separar múltiplas URLs por vírgula)
FRONTEND_URL=https://sgiufape.vercel.app

# Segurança de Cookies e Funcionalidades
COOKIE_SECURE=true
COOKIE_SAMESITE=Lax
EMAIL_ENABLED=true
SWAGGER_ENABLED=false
LOG_LEVEL=WARN
APP_LOG_LEVEL=INFO
